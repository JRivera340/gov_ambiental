# Credenciales de SOLO LECTURA del hub (gov-espacio-publico) para
# scripts/migrate-from-legacy.ts. Copiar a .env.migration (gitignored) y
# completar con los valores reales — nunca commitear ese archivo.
#
# En Railway: proyecto gov-espacio-publico, pestana "Connect" del servicio
# Postgres correspondiente al backend del hub (backend-api / Postgres).
OLD_DB_HOST=
OLD_DB_PORT=5432
OLD_DB_USERNAME=
OLD_DB_PASSWORD=
OLD_DB_DATABASE=
# true por defecto (Railway Postgres usa SSL). Poner false solo para una
# instancia local sin SSL.
OLD_DB_SSL=true
