# Copiá este archivo a .env y ajustá los valores. Ninguno de los valores de
# ejemplo de acá abajo es una credencial real.

NODE_ENV=development
PORT=3001
# Dominio(s) del frontend que puede llamar a esta API (separados por coma).
CORS_ORIGIN=http://localhost:5173
# URL pública de tu frontend — se usa como fallback en el link del reporte XLSX.
FRONTEND_URL=http://localhost:5173

# Secreto propio para firmar/verificar los JWT del login. Poné cualquier valor
# random para desarrollo local. Cambialo por uno largo y aleatorio antes de
# desplegar en un entorno real — cualquiera con este valor puede firmar
# tokens válidos para cualquier usuario.
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio

# En docker-compose, DB_HOST se sobreescribe a "db" automáticamente — estos
# valores solo importan si corrés el backend fuera de Docker.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ambiental
DB_PASSWORD=ambiental
DB_DATABASE=ambiental

# ── Almacenamiento de archivos (fotos, actas) ────────────────────────────
# 'local' (default): guarda en disco, sin configurar nada externo. Para un
# despliegue real con múltiples réplicas del backend se recomienda 'S3'.
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
# URL pública bajo la que este backend responde /api — se usa para construir
# el link de descarga de archivos en modo local. Si accedés desde la misma
# máquina donde corre docker-compose, el valor de abajo funciona sin cambios.
API_PUBLIC_URL=http://localhost:3001

# Para usar STORAGE_DRIVER=s3 (opcional), completá estas variables con las
# credenciales de tu proveedor compatible con S3 (AWS S3, Cloudflare R2,
# MinIO, Backblaze B2, etc.):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<tu-endpoint>
# S3_REGION=auto
# S3_BUCKET=<tu-bucket>
# S3_ACCESS_KEY_ID=<tu-access-key>
# S3_SECRET_ACCESS_KEY=<tu-secret-key>
# S3_PUBLIC_URL=https://<url-publica-de-tu-bucket>   (opcional — si no la
#   ponés, el backend genera URLs firmadas con expiración de 7 días)
