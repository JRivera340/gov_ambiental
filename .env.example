NODE_ENV=development
PORT=3001
# Dominio(s) del frontend que puede llamar a esta API (separados por coma).
CORS_ORIGIN=http://localhost:5173
# URL publica de tu frontend — se usa como fallback en el link del reporte XLSX.
FRONTEND_URL=http://localhost:5173

# Secreto propio para firmar/verificar JWT. Poné cualquier valor random para
# desarrollo local. En produccion: si este backend va a aceptar tokens
# emitidos por OTRO sistema de login (para compartir sesion sin duplicar
# usuarios), este valor tiene que ser IDENTICO al JWT_SECRET de ese otro
# sistema. Si este backend es totalmente independiente (con su propio login
# en el futuro), generá un secreto propio y no lo compartas con nadie.
JWT_SECRET=cambia-este-valor-en-produccion

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ambiental
DB_PASSWORD=ambiental
DB_DATABASE=ambiental

# Solo para "npm run migrate:legacy" — credenciales de SOLO LECTURA contra el
# Postgres viejo de gov-espacio-publico. Van en un archivo local .env.migration
# (nunca en este .env.example ni en .env), ver README para el detalle.
# OLD_DB_HOST=
# OLD_DB_PORT=5432
# OLD_DB_USERNAME=
# OLD_DB_PASSWORD=
# OLD_DB_DATABASE=
